---
import { getCollection } from "astro:content";
import Studio from "@/layouts/Studio.astro";

const blogs = await getCollection("blogs");
const sorted = blogs.sort(
	(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<Studio
	title="Writing"
	description="Notes and writing from the Prasuco product lab."
>
	<div class="max-w-3xl mx-auto px-6 py-14">
		<div class="space-y-2 border-b border-border pb-6 mb-6">
			<h1 class="text-3xl font-semibold tracking-tight text-ink">Writing</h1>
			<p class="text-muted">Occasional notes from the studio.</p>
		</div>

		<div class="divide-y divide-border">
			{
				sorted.map((blog) => (
					<a href={`/blogs/${blog.slug}`} class="block py-5">
						<h2 class="text-lg font-semibold text-ink hover:text-brand">
							{blog.data.title}
						</h2>
						<p class="text-sm text-muted mt-1">{blog.data.description}</p>
						<span class="inline-block mt-2 text-xs text-muted">
							{new Date(blog.data.publishDate).toLocaleDateString("en-US", {
								year: "numeric",
								month: "short",
								day: "numeric",
							})}
						</span>
					</a>
				))
			}
			{sorted.length === 0 && <p class="py-8 text-muted">No posts yet.</p>}
		</div>
	</div>
</Studio>
