---
import { getCollection } from "astro:content";
import Studio from "@/layouts/Studio.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { screenshots, faqs, techStack, liveUrl, repoUrl, logo, status } =
	project.data;

const primaryHref = liveUrl || repoUrl;
const primaryLabel = liveUrl ? "Open app" : "View source";
const ogImage = screenshots[0]
	? screenshots[0].src.startsWith("http")
		? screenshots[0].src
		: `https://prasuco.com${screenshots[0].src}`
	: undefined;

const productJsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: project.data.title,
	description: project.data.description,
	url: `https://prasuco.com/projects/${project.slug}`,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web",
	image: ogImage,
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	author: {
		"@type": "Organization",
		name: "Prasuco",
		url: "https://prasuco.com",
	},
	codeRepository: repoUrl,
	...(liveUrl ? { downloadUrl: liveUrl } : {}),
};
---

<Studio
	title={project.data.title}
	description={project.data.description}
	image={ogImage}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
	<div class="max-w-3xl mx-auto px-6 py-14">
		<p class="text-sm text-muted mb-8">
			<a href="/projects" class="text-brand hover:underline">← products</a>
		</p>

		<div class="border-b border-border pb-6 mb-8 space-y-4">
			<div class="flex items-center justify-between gap-4 flex-wrap">
				<div class="flex items-center gap-3">
					<img
						src={logo}
						alt={`${project.data.title} logo`}
						width="44"
						height="44"
						class="border border-border"
					/>
					<h1 class="text-3xl font-semibold tracking-tight text-ink">
						{project.data.title}
					</h1>
				</div>
				<span class="text-sm text-brand capitalize font-medium">{status}</span>
			</div>
			<p class="text-base text-muted leading-relaxed">
				{project.data.description}
			</p>
			<div class="flex flex-wrap gap-3">
				<a
					href={primaryHref}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center bg-brand text-white text-sm font-medium px-5 py-2.5 hover:bg-[#007a37]"
				>
					{primaryLabel}
				</a>
				{
					liveUrl && (
						<a
							href={repoUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center border border-ink text-ink text-sm font-medium px-5 py-2.5 hover:border-brand hover:text-brand"
						>
							Source
						</a>
					)
				}
			</div>
		</div>

		{
			screenshots.length > 0 && (
				<div class="space-y-6 mb-12">
					{screenshots.map((shot) => (
						<figure class="space-y-2">
							<div class="border border-border overflow-hidden">
								<img
									src={shot.src}
									alt={shot.alt}
									class="w-full h-auto"
									width="1280"
									height="800"
								/>
							</div>
							{shot.caption && (
								<figcaption class="text-xs text-muted">{shot.caption}</figcaption>
							)}
						</figure>
					))}
				</div>
			)
		}

		<section class="space-y-3 mb-10">
			<h2 class="text-lg font-semibold text-ink">About</h2>
			<div class="text-[15px] text-muted leading-relaxed space-y-4">
				<Content />
			</div>
		</section>

		{
			techStack.length > 0 && (
				<section class="space-y-3 mb-10">
					<h2 class="text-lg font-semibold text-ink">Details</h2>
					<div class="border border-border overflow-hidden">
						<table class="w-full text-left text-sm">
							<tbody class="divide-y divide-border">
								<tr>
									<td class="py-3 px-4 font-medium text-muted w-1/3">Status</td>
									<td class="py-3 px-4 text-ink capitalize">{status}</td>
								</tr>
								<tr>
									<td class="py-3 px-4 font-medium text-muted">Stack</td>
									<td class="py-3 px-4 text-ink">{techStack.join(", ")}</td>
								</tr>
								<tr>
									<td class="py-3 px-4 font-medium text-muted">Repository</td>
									<td class="py-3 px-4">
										<a
											href={repoUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="text-brand hover:underline"
										>
											{repoUrl.replace("https://github.com/", "")}
										</a>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>
			)
		}

		{
			faqs.length > 0 && (
				<section class="space-y-3">
					<h2 class="text-lg font-semibold text-ink">FAQ</h2>
					<div class="border border-border divide-y divide-border">
						{faqs.map((item) => (
							<details class="group">
								<summary class="w-full p-4 cursor-pointer list-none flex items-center justify-between hover:bg-canvas text-[15px] font-medium text-ink">
									{item.question}
									<span class="text-muted text-lg leading-none group-open:hidden">+</span>
									<span class="text-muted text-lg leading-none hidden group-open:inline">−</span>
								</summary>
								<p class="px-4 pb-4 text-sm text-muted leading-relaxed">
									{item.answer}
								</p>
							</details>
						))}
					</div>
				</section>
			)
		}
	</div>
</Studio>

<style>
	details summary::-webkit-details-marker {
		display: none;
	}
</style>
