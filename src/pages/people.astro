---
import Studio from "@/layouts/Studio.astro";
---

<Studio
	title="People"
	description="Meet the people behind Prasuco — an independent product lab shipping focused software."
>
	<div class="max-w-3xl mx-auto px-6 py-14">
		<div class="space-y-3 border-b border-border pb-8 mb-8">
			<h1 class="text-3xl font-semibold tracking-tight text-ink">People</h1>
			<p class="text-muted leading-relaxed">
				A small independent studio. Friends hacking on ideas, shipping what
				works, and sharing the code.
			</p>
		</div>

		<article class="flex flex-col sm:flex-row gap-5 items-start mb-10">
			<div
				class="w-20 h-20 bg-brand text-white flex items-center justify-center text-2xl font-semibold shrink-0"
			>
				PS
			</div>
			<div>
				<div class="flex items-baseline justify-between gap-3 mb-1 flex-wrap">
					<h2 class="text-lg font-semibold text-ink">Prabin Subedi</h2>
					<span class="text-sm text-muted">Founder</span>
				</div>
				<p class="text-[15px] text-muted leading-relaxed mb-3">
					Builds and ships the studio’s products.
				</p>
				<a
					href="https://github.com/prabin-subedi"
					target="_blank"
					rel="noopener noreferrer"
					class="text-sm text-brand hover:underline">github</a
				>
			</div>
		</article>

		<section class="border-t border-border pt-8">
			<h2 class="text-lg font-semibold text-ink mb-2">Working together</h2>
			<p class="text-[15px] text-muted leading-relaxed">
				Browse
				<a
					href="https://github.com/prasuco"
					target="_blank"
					rel="noopener noreferrer"
					class="text-brand hover:underline">github.com/prasuco</a
				>
				or write to
				<a href="mailto:work@prasuco.com" class="text-brand hover:underline"
					>work@prasuco.com</a
				>.
			</p>
		</section>
	</div>
</Studio>
