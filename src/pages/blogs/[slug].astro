---
import { getCollection } from "astro:content";
import Studio from "@/layouts/Studio.astro";

function formatDate(date: string | Date) {
	return new Date(date).toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric",
	});
}

export async function getStaticPaths() {
	const blogs = await getCollection("blogs");
	return blogs.map((blog) => ({
		params: { slug: blog.slug },
		props: { post: blog },
	}));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Studio
	title={post.data.title}
	description={post.data.description}
	type="article"
>
	<article class="max-w-3xl mx-auto px-6 py-14">
		<p class="text-sm text-muted mb-6">
			<a href="/blogs" class="text-brand hover:underline">← writing</a>
		</p>
		<h1 class="text-3xl font-semibold tracking-tight text-ink leading-tight mb-3">
			{post.data.title}
		</h1>
		<p class="text-base text-muted mb-3">{post.data.description}</p>
		<p class="text-xs text-muted mb-8">
			{formatDate(post.data.publishDate)} · {post.data.author}
		</p>
		<div class="border-t border-border pt-8 text-[15px] text-muted leading-relaxed space-y-4">
			<Content />
		</div>
	</article>
</Studio>
