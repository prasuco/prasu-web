---
import Studio from "@/layouts/Studio.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

const order = { shipping: 0, library: 1, experiment: 2, archived: 3 } as const;

const catalog = [...projects].sort((a, b) => {
	const byStatus = order[a.data.status] - order[b.data.status];
	if (byStatus !== 0) return byStatus;
	return a.data.title.localeCompare(b.data.title);
});
---

<Studio
	title="Home"
	description="Prasuco is an independent product lab. We build focused apps and open-source libraries — geeta-mini, easy-sewa, formy, and more."
>
	<div class="max-w-3xl mx-auto px-6 py-14 space-y-14">
		<section class="space-y-5 max-w-2xl">
			<h1 class="text-3xl sm:text-4xl font-semibold tracking-tight leading-[1.15] text-ink">
				We build focused software for
				<span class="text-brand">people</span>.
			</h1>
			<p class="text-[15px] text-muted leading-relaxed">
				An independent product lab. Small apps and libraries, shipped openly —
				with restraint, not theater.
			</p>
			<div class="flex flex-wrap items-center gap-3 pt-1">
				<a
					href="/projects"
					class="inline-flex items-center bg-brand text-white text-sm font-medium px-5 py-2.5 hover:bg-[#007a37]"
				>
					See products →
				</a>
				<a
					href="https://github.com/prasuco"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center border border-ink text-ink text-sm font-medium px-5 py-2.5 hover:border-brand hover:text-brand"
				>
					GitHub
				</a>
			</div>
		</section>

		<hr class="border-border" />

		<section class="space-y-8">
			<div class="flex items-end justify-between gap-4">
				<h2 class="text-xl font-semibold text-ink">Products</h2>
				<a href="/projects" class="text-sm text-brand hover:underline">all →</a>
			</div>

			{
				catalog.map((project) => {
					const shot = project.data.screenshots[0];
					return (
						<article class="space-y-3 border-b border-border pb-8 last:border-0 last:pb-0">
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
								<div class="flex items-center gap-3 min-w-0">
									<img
										src={project.data.logo}
										alt={`${project.data.title} logo`}
										width="36"
										height="36"
										class="border border-border shrink-0"
									/>
									<div class="min-w-0">
										<div class="flex items-center gap-2 flex-wrap">
											<h3 class="text-lg font-semibold text-ink">
												{project.data.title}
											</h3>
											<span class="text-xs text-brand capitalize font-medium">
												{project.data.status}
											</span>
										</div>
										<p class="text-sm text-muted mt-0.5 leading-snug">
											{project.data.description}
										</p>
									</div>
								</div>
								<a
									href={`/projects/${project.slug}`}
									class="shrink-0 text-sm font-medium text-brand hover:underline"
								>
									{project.data.liveUrl ? "Open →" : "Details →"}
								</a>
							</div>

							{shot && (
								<a
									href={`/projects/${project.slug}`}
									class="block border border-border overflow-hidden hover:border-brand"
								>
									<img
										src={shot.src}
										alt={shot.alt}
										class="w-full h-auto max-h-64 object-cover object-top"
										width="1280"
										height="800"
										loading="lazy"
									/>
								</a>
							)}
						</article>
					);
				})
			}
		</section>

		<hr class="border-border" />

		<section class="space-y-5">
			<h2 class="text-xl font-semibold text-ink">Principles</h2>
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
				<div>
					<p class="text-brand font-semibold mb-1">1</p>
					<h3 class="font-semibold text-ink mb-1">Build small</h3>
					<p class="text-sm text-muted leading-relaxed">
						One job, done well. No feature sprawl.
					</p>
				</div>
				<div>
					<p class="text-brand font-semibold mb-1">2</p>
					<h3 class="font-semibold text-ink mb-1">Share the code</h3>
					<p class="text-sm text-muted leading-relaxed">
						Open source by default. Fork and build on it.
					</p>
				</div>
				<div>
					<p class="text-brand font-semibold mb-1">3</p>
					<h3 class="font-semibold text-ink mb-1">Quiet tools</h3>
					<p class="text-sm text-muted leading-relaxed">
						No spam. Do the job and get out of the way.
					</p>
				</div>
			</div>
		</section>

		<hr class="border-border" />

		<section class="space-y-2">
			<h2 class="text-lg font-semibold text-ink">Contact</h2>
			<p class="text-sm text-muted">
				Questions or collabs —
				<a
					href="mailto:work@prasuco.com"
					class="text-brand font-medium hover:underline">work@prasuco.com</a
				>
			</p>
		</section>
	</div>
</Studio>
