---
import Studio from "@/layouts/Studio.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const order = ["shipping", "library", "experiment", "archived"] as const;
const labels = {
	shipping: "Shipping",
	library: "Libraries",
	experiment: "Experiments",
	archived: "Archived",
} as const;

const sections = order
	.map((status) => ({
		status,
		label: labels[status],
		items: projects.filter((p) => p.data.status === status),
	}))
	.filter((s) => s.items.length > 0);
---

<Studio title="Products" description="Browse Prasuco products — geeta-mini, easy-sewa, formy, and open-source tools from the lab.">
	<div class="max-w-3xl mx-auto px-6 py-14 space-y-10">
		<div class="space-y-2 border-b border-border pb-6">
			<h1 class="text-3xl font-semibold tracking-tight text-ink">Products</h1>
			<p class="text-muted">Applications and libraries from the studio.</p>
		</div>

		{
			sections.map((section) => (
				<section class="space-y-5">
					<h2 class="text-lg font-semibold text-ink">{section.label}</h2>
					<div class="space-y-6">
						{section.items.map((project) => (
							<article class="flex gap-4 items-start border-b border-border pb-5 last:border-0">
								<img
									src={project.data.logo}
									alt=""
									width="48"
									height="48"
									class="border border-border shrink-0"
								/>
								<div class="min-w-0 flex-1">
									<div class="flex flex-wrap items-baseline justify-between gap-2">
										<h3 class="text-lg font-semibold text-ink">
											<a
												href={`/projects/${project.slug}`}
												class="hover:text-brand"
											>
												{project.data.title}
											</a>
										</h3>
										<a
											href={`/projects/${project.slug}`}
											class="text-sm font-medium text-brand hover:underline"
										>
											Details →
										</a>
									</div>
									<p class="text-sm text-muted mt-1 leading-relaxed">
										{project.data.description}
									</p>
								</div>
							</article>
						))}
					</div>
				</section>
			))
		}
	</div>
</Studio>
